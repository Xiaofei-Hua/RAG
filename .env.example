# =============================================================================
# LLM - any OpenAI-compatible endpoint
# =============================================================================
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=qwen3:14b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1

# =============================================================================
# Embedding - local path is preferred when it exists, otherwise model ID loads
# from Hugging Face. EMBEDDING_DIMENSION must match the selected model.
# Rebuild the Milvus collection after changing model or dimension.
# =============================================================================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=models/local_models/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=8

# Optional cross-encoder reranker. Hub IDs download into ~/.cache/huggingface;
# set RERANKER_MODEL_PATH to load an explicit local directory instead.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL_PATH=
RERANKER_DEVICE=cpu
RERANKER_WARMUP=false
RERANKER_CANDIDATE_TOP_K=10
RERANKER_TOP_K=5
RERANKER_BATCH_SIZE=8

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rag-platform
# OTLP/HTTP trace endpoint, for example http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATE=1.0
OTEL_CONSOLE_EXPORTER=false

# Storage
MILVUS_DB_URI=./milvus_data.db
COLLECTION_NAME=t_collection01

# PDF ingestion
# Text-layer PDFs are parsed with pypdfium2 and pypdf. Table extraction is a
# conservative text-layout heuristic; scanned/image-only pages require OCR.
PDF_EXTRACT_TABLES=true
PDF_OCR_ENABLED=false
PDF_OCR_ENGINE=paddleocr
PDF_OCR_LANG=ch
PDF_OCR_DPI=220
PDF_OCR_MIN_TEXT_CHARS=20
PDF_ASSET_DIR=data/document_assets
# Project code defaults this to 0 for CPU compatibility. Set to 1 only after
# validating PaddleOCR CPU inference on the target host.
# PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0

# Optional: public URL prefix when FastAPI is behind a stripping reverse proxy.
# APP_ROOT_PATH=/rag
